---
/**
 * FeatureGrid — three-column feature cards with inline stroke icons.
 * Icon names are resolved from a small local map to keep the markup honest
 * (no icon font, no extra request).
 */
interface Props {
  items: { title: string; text: string; icon: string }[];
}

const { items } = Astro.props;

const icons: Record<string, string> = {
  flag: '<path d="M5 3v18M5 4h11l-2 4 2 4H5"/>',
  blocks:
    '<path d="M3 9l4.5-3 4.5 3-4.5 3z"/><path d="M12 15l4.5-3 4.5 3-4.5 3z"/><path d="M7.5 12v6"/><path d="M16.5 12V6"/>',
  ghost:
    '<path d="M12 3a7 7 0 0 1 7 7v11l-2.3-2-2.3 2-2.4-2-2.4 2-2.3-2L5 21V10a7 7 0 0 1 7-7z"/><path d="M9.5 10h.01M14.5 10h.01"/>',
  trophy:
    '<path d="M8 4h8v5a4 4 0 0 1-8 0z"/><path d="M8 5H5a3 3 0 0 0 3 5M16 5h3a3 3 0 0 1-3 5"/><path d="M12 13v4M9 20h6"/>',
  paint:
    '<path d="M4 20a2 2 0 0 0 2-2 2 2 0 0 1 4 0 2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a6 6 0 0 0-6-6H9a5 5 0 0 0-5 5z"/><path d="M8 9h.01M12 7h.01M15 10h.01"/>',
  users:
    '<path d="M16 19v-1a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v1"/><circle cx="9" cy="7" r="3"/><path d="M20 19v-1a4 4 0 0 0-3-3.9"/><path d="M15.5 4.1a3 3 0 0 1 0 5.8"/>',
};
---

<div class="not-prose mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {items.map((item) => (
    <article class="card p-5 transition-colors hover:border-[var(--border-hover)]">
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--color-primary-600)]/15 text-[var(--color-primary-300)]">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-5 w-5"
          aria-hidden="true"
          set:html={icons[item.icon] ?? icons.flag}
        />
      </span>
      <h3 class="mt-4 text-sm font-semibold text-[var(--text-primary)]">{item.title}</h3>
      <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-secondary)]">{item.text}</p>
    </article>
  ))}
</div>
