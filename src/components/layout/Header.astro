---
/**
 * Header.astro — sticky top bar with main navigation, language switch and the
 * primary "Play Now" action. Vanilla JS only; no framework island.
 */
import { getLangFromUrl, useTranslations, localizedHref, alternatesFor } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = Astro.url.pathname;

const nav = [
  { label: t('nav.home'), path: '/', match: 'exact' },
  { label: t('nav.howToPlay'), path: '/how-to-play/' },
  { label: t('nav.controls'), path: '/controls/' },
  { label: t('nav.trackEditor'), path: '/track-editor/' },
  { label: t('nav.unblocked'), path: '/unblocked/' },
  { label: t('nav.about'), path: '/about/' },
];

const links = nav.map((item) => ({ ...item, href: localizedHref(lang, item.path) }));

const alternates = alternatesFor(Astro.url);
const otherLang = alternates.find((alt) => alt.lang !== lang) ?? alternates[0];
const otherLangLabel = otherLang.lang === 'es' ? 'ES' : 'EN';

const isActive = (href: string, match?: string) =>
  match === 'exact' ? path === href || path === href.replace(/\/$/, '') : path.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-[var(--border)] bg-[var(--bg)]/85 backdrop-blur-xl"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 md:px-6">
    <a href={localizedHref(lang, '/')} class="flex shrink-0 items-center gap-2.5">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--color-primary-600)] shadow-[0_6px_20px_-6px_rgb(77_120_255_/_0.9)]"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="white"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <path d="M5 17h14M6.5 17V11l1.8-3.5h7.4L17.5 11v6" />
          <circle cx="8.5" cy="18.5" r="1.6" />
          <circle cx="15.5" cy="18.5" r="1.6" />
          <path d="M4 4l2 2M20 4l-2 2" />
        </svg>
      </span>
      <span class="font-display text-[1.05rem] font-bold tracking-tight">
        PolyTrack<span class="text-[var(--color-primary-400)]">Online</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label={t('nav.mainNav')}>
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
            isActive(link.href, link.match)
              ? 'bg-[var(--bg-elevated)] text-[var(--text-primary)]'
              : 'text-[var(--text-secondary)] hover:bg-[var(--bg-elevated)] hover:text-[var(--text-primary)]',
          ]}
          aria-current={isActive(link.href, link.match) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={otherLang.href}
        hreflang={otherLang.lang}
        lang={otherLang.lang}
        aria-label={`${t('lang.switch')}: ${otherLang.label}`}
        class="hidden h-9 items-center rounded-lg border border-[var(--border)] px-2.5 text-xs font-semibold tracking-wide text-[var(--text-secondary)] transition-colors hover:border-[var(--border-hover)] hover:text-[var(--text-primary)] sm:inline-flex"
      >
        {otherLangLabel}
      </a>

      <a href={localizedHref(lang, '/')} class="btn-primary !px-4 !py-2 text-[0.8rem]">
        {t('cta.playNow')}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="h-3.5 w-3.5"
          aria-hidden="true"
        >
          <path d="M8 5v14l11-7z" />
        </svg>
      </a>

      <button
        id="menu-btn"
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-lg border border-[var(--border)] text-[var(--text-secondary)] transition-colors hover:text-[var(--text-primary)] lg:hidden"
        aria-label={t('nav.openMenu')}
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          class="h-4.5 w-4.5"
        >
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="hidden border-t border-[var(--border)] bg-[var(--bg-secondary)] px-4 py-3 lg:hidden"
    aria-label={t('nav.mobileNav')}
  >
    <ul class="flex flex-col">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'block rounded-lg px-3 py-2.5 text-sm font-medium',
              isActive(link.href, link.match)
                ? 'text-[var(--text-primary)]'
                : 'text-[var(--text-secondary)]',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="mt-2 border-t border-[var(--border)] pt-2 sm:hidden">
        <a
          href={otherLang.href}
          hreflang={otherLang.lang}
          class="block rounded-lg px-3 py-2.5 text-sm font-medium text-[var(--text-secondary)]"
        >
          {otherLang.label}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === true;
    btn.setAttribute('aria-expanded', String(!open));
  });
</script>
