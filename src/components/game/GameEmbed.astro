---
/**
 * GameEmbed.astro — click-to-load player for the self-hosted PolyTrack build.
 *
 * The 3D bundle is roughly 2 MB, so it is deliberately *not* loaded on page
 * load: the poster keeps LCP fast, and the iframe is injected on the first
 * click (or on Enter/Space on the button). Because the game is served from the
 * same origin as the page, there is no cross-origin frame restriction — the
 * upstream host sets `frame-ancestors` that forbid embedding, which is exactly
 * why the build is mirrored into /public/poly-track.
 */
import { SITE, GAME_SRC, asset } from '../../config/site';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const poster = asset('/game-poster.jpg');
---

<div class="not-prose">
  <div
    id="game-shell"
    class="group relative aspect-video w-full overflow-hidden rounded-2xl border border-[var(--border-hover)] bg-[#05070f] shadow-[0_0_0_1px_rgb(255_255_255_/_0.04),0_40px_80px_-40px_rgb(77_120_255_/_0.65)] md:aspect-auto md:h-[clamp(560px,78vh,760px)]"
    data-src={GAME_SRC}
  >
    <!-- Blurred cover copy of the poster fills the letterbox bands the
         contained poster leaves on tall frames. Decorative only. -->
    <div id="game-poster-bg" class="absolute inset-0" aria-hidden="true">
      <img
        src={poster}
        alt=""
        class="h-full w-full scale-110 object-cover opacity-70 blur-2xl"
        loading="eager"
        decoding="async"
      />
      <div
        class="absolute inset-0 bg-gradient-to-b from-[#05070f]/85 via-transparent to-[#05070f]/90"
      >
      </div>
    </div>

    <img
      id="game-poster"
      src={poster}
      width="1280"
      height="720"
      alt={t('game.posterAlt')}
      class="absolute inset-0 h-full w-full object-contain"
      fetchpriority="high"
      decoding="async"
    />

    <div
      id="game-veil"
      class="absolute inset-0 flex flex-col items-center justify-center gap-4 bg-[radial-gradient(ellipse_at_center,rgba(6,9,18,0.86)_0%,rgba(6,9,18,0.72)_42%,rgba(6,9,18,0.5)_100%)] p-6 text-center backdrop-blur-[3px]"
    >
      <button id="game-play" type="button" class="btn-primary !px-6 !py-3.5 !text-base">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <path d="M8 5v14l11-7z" />
        </svg>
        {t('game.play')}
      </button>
      <p class="max-w-sm text-xs leading-relaxed text-[var(--text-secondary)]">
        {t('game.playHint')}
      </p>
      <span class="chip !bg-[#0b1120]/80">v{SITE.gameVersion}</span>
    </div>

    <div
      id="game-loader"
      class="absolute inset-0 hidden flex-col items-center justify-center gap-3 bg-[#060912] text-center"
      aria-live="polite"
    >
      <span
        class="h-8 w-8 animate-spin rounded-full border-2 border-[var(--border-hover)] border-t-[var(--accent)]"
      ></span>
      <p class="text-sm font-medium text-[var(--text-primary)]">{t('game.loading')}</p>
      <p class="max-w-xs text-xs text-[var(--text-tertiary)]">{t('game.loadingNote')}</p>
      <a
        id="game-slow-link"
        href={GAME_SRC}
        target="_blank"
        rel="noopener"
        class="mt-1 hidden text-xs font-medium text-[var(--color-primary-300)] underline underline-offset-2"
      >
        {t('game.openTab')}
      </a>
    </div>

    <noscript>
      <div class="absolute inset-0 flex items-center justify-center bg-[#060912] p-6 text-center">
        <a href={GAME_SRC} class="btn-primary"> {t('game.openTab')} </a>
      </div>
    </noscript>
  </div>

  <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-2 text-xs text-[var(--text-tertiary)]">
      <span class="chip">v{SITE.gameVersion}</span>
      <span class="chip">W A S D</span>
      <span class="chip">{t('nav.controls')}</span>
    </div>
    <div class="flex items-center gap-2">
      <button
        id="game-fullscreen"
        type="button"
        class="btn-secondary !px-3.5 !py-2 !text-xs"
        data-enter-label={t('game.fullscreen')}
        data-exit-label={t('game.exitFullscreen')}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="h-3.5 w-3.5"
          aria-hidden="true"
        >
          <path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3" />
        </svg>
        <span id="game-fs-label">{t('game.fullscreen')}</span>
      </button>
      <a
        href={GAME_SRC}
        target="_blank"
        rel="noopener"
        class="btn-secondary !px-3.5 !py-2 !text-xs"
      >
        {t('game.openTab')}
      </a>
    </div>
  </div>

  <p class="mt-2 text-[0.7rem] leading-relaxed text-[var(--text-tertiary)]">
    {t('game.modNote')}{' '}
    <a
      href="https://www.crazygames.com/game/polytrack"
      target="_blank"
      rel="noopener noreferrer"
      class="underline decoration-dotted underline-offset-2 hover:text-[var(--text-primary)]"
    >
      CrazyGames
    </a>.
  </p>
</div>

<style is:global>
  /* Not scoped: the iframe is injected by JS, so it never receives the
     component's data-astro-cid attribute. */
  #game-shell iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    background: #05070f;
  }

  #game-shell:fullscreen {
    border-radius: 0;
    border: 0;
    aspect-ratio: auto;
    width: 100vw;
    height: 100vh;
  }
</style>

<script>
  const shell = document.getElementById('game-shell') as HTMLElement | null;
  const playBtn = document.getElementById('game-play') as HTMLButtonElement | null;
  const veil = document.getElementById('game-veil');
  const loader = document.getElementById('game-loader');
  const poster = document.getElementById('game-poster');
  const posterBg = document.getElementById('game-poster-bg');
  const fsBtn = document.getElementById('game-fullscreen');
  const fsLabel = document.getElementById('game-fs-label');
  const slowLink = document.getElementById('game-slow-link');

  let started = false;

  function start() {
    if (!shell || started) return;
    started = true;

    const src = shell.dataset.src;
    if (!src) return;

    veil?.classList.add('hidden');
    poster?.classList.add('hidden');
    posterBg?.classList.add('hidden');
    loader?.classList.remove('hidden');
    loader?.classList.add('flex');

    const frame = document.createElement('iframe');
    frame.src = src;
    frame.title = 'PolyTrack';
    frame.setAttribute('allow', 'fullscreen; autoplay; gamepad');
    frame.setAttribute('allowfullscreen', 'true');
    frame.setAttribute('scrolling', 'no');
    // Inline, because the element is created after the stylesheet is parsed.
    frame.style.cssText =
      'position:absolute;inset:0;width:100%;height:100%;border:0;display:block;background:#05070f';
    frame.addEventListener('load', () => {
      loader?.classList.add('hidden');
      loader?.classList.remove('flex');
      frame.focus();
    });
    shell.appendChild(frame);

    // If the engine takes unusually long, offer a direct link as an escape hatch.
    window.setTimeout(() => slowLink?.classList.remove('hidden'), 12000);
  }

  playBtn?.addEventListener('click', start);

  fsBtn?.addEventListener('click', () => {
    if (!shell) return;
    if (!started) start();
    if (document.fullscreenElement) {
      document.exitFullscreen?.();
    } else {
      shell.requestFullscreen?.().catch(() => {
        /* fullscreen may be denied by policy; the game stays inline */
      });
    }
  });

  document.addEventListener('fullscreenchange', () => {
    if (!fsBtn || !fsLabel) return;
    const active = Boolean(document.fullscreenElement);
    fsLabel.textContent = active
      ? (fsBtn as HTMLElement).dataset.exitLabel || 'Exit fullscreen'
      : (fsBtn as HTMLElement).dataset.enterLabel || 'Fullscreen';
  });
</script>
