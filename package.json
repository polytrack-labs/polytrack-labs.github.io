{
  "name": "polytrack-online",
  "type": "module",
  "version": "0.1.0",
  "description": "PolyTrack Online \u2014 a fast, ad-free browser mirror of the PolyTrack low-poly racing game, built with Astro and deployed to GitHub Pages.",
  "author": "calcnate",
  "license": "MIT",
  "keywords": [
    "polytrack",
    "racing game",
    "browser game",
    "astro",
    "github pages",
    "seo",
    "i18n"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
